# GitHub App webhook settings
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Fine-grained PAT with Metadata: Read and Issues: Read for every allowed repository.
GITHUB_TOKEN=github_pat_replace_me
ALLOWED_REPOSITORIES=owner/repository,another-owner/another-repository

# At least one platform token is required for useful delivery.
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# This HTTP endpoint is intended only for a TLS-terminating reverse proxy.
HOST=0.0.0.0
PORT=3000
WEBHOOK_PATH=/webhook/github
DATA_DIR=/var/lib/webhook-noti