# Non-secret deployment configuration. Tokens and webhook secrets are loaded
# only from the Docker secret files declared in compose.yaml.
ALLOWED_REPOSITORIES=owner/repository,another-owner/another-repository
GITHUB_APP_ID=12345

# Optional: route GitHub, Discord (REST + Gateway), and Telegram API traffic through a
# SOCKS5 upstream via an internal local HTTP CONNECT bridge.
# SOCKS_PROXY_URL=socks5://user:pass@proxy-host:1080
